#!/usr/bin/expect -f
# Drives `lazy-pundit init` through a real terminal, in a new temp home, with
# the fetch replayed offline. Run it with `npm run -s drive:wizard -- <scenario>`.
#
#   full            every default, the key skipped, no second league
#   folder <path>   the same, with this workspace folder (~/my-league works too)
#   relative        the folder typed as my-league, refused, asked again, left empty
#   dot             the folder typed as <home>/ws., the fix without the dot taken
#   dot-keep        the same, with <home>/ws. kept as typed
#   next-to         config.yaml already lists a workspace at <home>/elsewhere/league-a,
#                   so the folder left empty is <home>/elsewhere/fear-the-turtle
#   bad-id          an unknown league ID, re-asked, then Ctrl-C
#   yahoo           pick a platform that stops the wizard
#   espn            ESPN, replaying Hot Takery's week 8 (read as a public league, so no
#                   cookie is asked), every default into <home>/ws, then setup espn
#                   with LAZY_PUNDIT_ESPN_S2 set (warned) and a pasted 300-character
#                   cookie, which the replay accepts, shown as "pasted, 300 characters"
#   espn-bad-id     ESPN with an unknown league ID, re-asked, then Ctrl-C
#   espn-private    the same league private to one cookie (LAZY_PUNDIT_REPLAY_COOKIE):
#                   refused without one, the cookie help, that 300-character cookie
#                   pasted (shown as "pasted, 300 characters"), every
#                   default; checks credentials.yaml is 0600 and no workspace file
#                   holds the cookie
#   espn-retype     the private league with a wrong cookie pasted, rejected, then
#                   "Type the league ID again", then Ctrl-C at the ID
#   espn-env-cookie the private league with a wrong cookie in LAZY_PUNDIT_ESPN_S2,
#                   which ends init with the rejection as the frame's closing line
#   cancel          Ctrl-C at the first prompt
#   cancel-folder   Ctrl-C at the folder prompt
#   rename          rename the first handle to "gus", pick standings
#   skip-rest       Skip the rest at the handles step
#   key             enter a full-length key (shown as "pasted, 108 characters"),
#                   which the replay can't check, so it's saved with
#                   a warning that it couldn't be checked; cap 0.10
#   another         every default, then a second league, cancelled at its name
#   again           every default, then a second league with the same league ID
#                   typed, refused as already set up, re-asked, then Ctrl-C
#   stakes          money at stake: buy-in 50, the default payouts, a $10 weekly high score
#   family          a family league type, so the family league and Family persona are preselected
#   setup-lore      every default into <home>/ws, a hand edit to lore.md, then setup lore
#                   declined at the diff and run again confirmed
#   setup-stakes    the stakes scenario into <home>/ws, week 8 drafted and published,
#                   then setup stakes paying $20, whose changed-outcome warning
#                   shows before the confirm
#
# It prints the wizard's output, then `WROTE <folders>` (each folder holding a
# workspace.md under the home, relative to it, or "nothing"), `HOME <path>` and
# `EXIT <code>`, and exits with the wizard's code. Look in that home for what the wizard wrote. A new
# wizard step needs its prompt and answer added at the bottom of this file.
# Wait for the prompt's own line, "\u25c6  <label>": a label alone also matches
# the explanation and earlier redraws, so the answer can arrive before the
# prompt listens.

# Every scenario, in the order drive-wizard-all.sh runs them. It reads this line.
set scenarios {full folder relative dot dot-keep next-to bad-id yahoo espn espn-bad-id espn-private espn-retype espn-env-cookie cancel cancel-folder rename skip-rest key another again stakes family setup-lore setup-stakes}
# The scenarios that exit 1: those ending with Ctrl-C, as a cancelled setup
# does, and those ending with an error. drive-wizard-all.sh reads this line.
set exits_one {bad-id espn-bad-id espn-retype espn-env-cookie cancel cancel-folder another again}

set scenario [lindex $argv 0]
set folder [lindex $argv 1]
if {$scenario ni $scenarios} {
  set usage {}
  foreach s $scenarios {
    lappend usage [expr {$s eq "folder" ? "folder <path>" : $s}]
  }
  puts stderr "Usage: drive-wizard.exp [join $usage |]"
  exit 2
}
if {$scenario eq "folder" && $folder eq ""} {
  puts stderr "The folder scenario needs a path."
  exit 2
}

set repo [file dirname [file dirname [file normalize [info script]]]]
set home [file normalize [exec mktemp -d]]
if {[string first "$repo/" "$home/"] == 0} {
  puts stderr "Refusing to run: the temp home $home is inside the repo. Check TMPDIR."
  exit 2
}
cd $home

set env(HOME) $home
set env(XDG_CONFIG_HOME) "$home/.config"
set env(XDG_CACHE_HOME) "$home/.cache"
set env(LAZY_PUNDIT_CLIPBOARD) off
# Plain output on every machine: CI has no NO_COLOR, and a coloured prompt
# symbol, such as the one the key scenario waits for, never matches.
set env(NO_COLOR) 1
catch {unset env(FORCE_COLOR)}
# A real espn_s2 is about 300 characters and an Anthropic key about 108, long
# enough that a mask of one character each would wrap; the masked prompts
# show only the count.
set COOKIE "AEB%2F[string repeat r 294]"
set KEY "sk-ant-api03-[string repeat x 95]"
set espn [expr {[string match "espn*" $scenario]}]
if {$espn} {
  set env(LAZY_PUNDIT_REPLAY) "$repo/fixtures/espn/hot-takery-2025/20251028T120000Z-a095861f"
  # ESPN's URLs name the season, which setup takes from the clock.
  set env(LAZY_PUNDIT_NOW) "2025-10-28T15:00:00.000Z"
  catch {unset env(LAZY_PUNDIT_REPLAY_COOKIE)}
  if {$scenario in {espn-private espn-retype espn-env-cookie}} {
    set env(LAZY_PUNDIT_REPLAY_COOKIE) $COOKIE
  }
} else {
  set env(LAZY_PUNDIT_REPLAY) "$repo/fixtures/sleeper/fear-the-turtle-2025/20251028T120000Z-c4a2c21d"
}
catch {unset env(ANTHROPIC_API_KEY)}
catch {unset env(LAZY_PUNDIT_ESPN_S2)}
if {$scenario eq "espn-env-cookie"} { set env(LAZY_PUNDIT_ESPN_S2) "AEB%2Fwrong" }

# A real width: a terminal of width 0 makes clack wrap one character per line.
set stty_init "cols 120 rows 40"
# Read the wizard's output as UTF-8 whatever the locale, so a prompt's symbol matches.
encoding system utf-8
set timeout 15

# The folders under the home holding a workspace.md, relative to it, so a
# scenario shows where init put the workspace.
proc wrote {home} {
  set found [lsort [split [string trim [exec find $home -name workspace.md -not -path "$home/.*"]] "\n"]]
  set dirs {}
  foreach f $found {
    if {$f ne ""} { lappend dirs [string range [file dirname $f] [string length "$home/"] end] }
  }
  if {$dirs eq {}} { return "nothing" }
  return [join $dirs " "]
}

# Where these scenarios' workspace should land; any other WROTE exits 7, which
# drive-wizard-all.sh counts as a failure.
array set writes {
  full lazy-pundit/fear-the-turtle
  relative lazy-pundit/fear-the-turtle
  dot ws
  dot-keep ws.
  next-to elsewhere/fear-the-turtle
  cancel-folder nothing
  espn ws
  espn-bad-id nothing
  espn-private lazy-pundit/the-hot-takery-league-2-0
  espn-retype nothing
  espn-env-cookie nothing
}

# espn-private's checks once init is done: credentials.yaml at 0600 holding
# the cookie, and no file in the workspace holding it. Any miss exits 7.
proc private_checks {home code} {
  global COOKIE
  set path "$home/.config/lazy-pundit/credentials.yaml"
  if {![file exists $path]} { puts "\nNO CREDENTIALS"; return 7 }
  set mode [file attributes $path -permissions]
  set fh [open $path]; set stored [read $fh]; close $fh
  puts "\nCREDENTIALS $mode"
  if {$mode ne "00600" || [string first $COOKIE $stored] < 0} {
    puts "WRONG CREDENTIALS"; return 7
  }
  if {![catch {exec grep -rl $COOKIE "$home/lazy-pundit"}]} {
    puts "COOKIE IN WORKSPACE"; return 7
  }
  return $code
}

proc finish {} {
  global home
  expect {
    eof {}
    timeout { puts "\nHUNG"; exec kill -9 [exp_pid]; exit 9 }
  }
  lassign [wait] pid spawnid oserror code
  global scenario writes
  if {$scenario eq "espn-private" && $code == 0} { set code [private_checks $home $code] }
  set wrote [wrote $home]
  puts "\nWROTE $wrote"
  if {[info exists writes($scenario)] && $wrote ne $writes($scenario)} {
    puts "WRONG FOLDER: should be $writes($scenario)"
    set code 7
  }
  puts "HOME $home\nEXIT $code"
  exit $code
}

proc need {prompt} {
  # A pattern starting with the gutter crashed macOS's expect (exit 138, no
  # EXIT line) in 6 of 10 runs in #114: match the text after "│  ".
  if {[string match "│*" $prompt]} {
    puts stderr "need: start the pattern after \"│  \"; one starting with │ crashes expect (exit 138)"
    exit 2
  }
  expect {
    -ex $prompt { after 300 }
    timeout { puts "\nTIMEOUT waiting for \"$prompt\""; exec kill -9 [exp_pid]; exit 9 }
    eof { puts "\nEOF waiting for \"$prompt\""; exit 8 }
  }
}

set DOWN "\033\[B"
set CTRL_C "\x03"

if {$scenario eq "next-to"} {
  # A workspace for another league, listed but never made, so the league
  # match skips it.
  file mkdir "$home/.config/lazy-pundit"
  set config [open "$home/.config/lazy-pundit/config.yaml" w]
  puts $config "format: 1\nworkspaces:\n  league-a: $home/elsewhere/league-a"
  close $config
}

spawn node "$repo/src/cli.ts" init
need "pundit name"
if {$scenario eq "cancel"} { send $CTRL_C; finish }
send "Rikhin\r"

need "Which platform"
if {$scenario eq "yahoo"} { send "$DOWN"; after 200; send "$DOWN"; after 200; send "\r"; finish }
if {$espn} {
  send "$DOWN"; after 200; send "\r"
  need "◆  ESPN league ID"
  if {$scenario eq "espn-bad-id"} {
    send "123\r"
    need "ESPN has no league 123"
    need "◆  ESPN league ID"
    send $CTRL_C
    finish
  }
  send "900000001\r"
  if {$scenario eq "espn-env-cookie"} {
    # The closing line, not a bare one: a run that leaves the frame open hits EOF here.
    need "└  ESPN rejected the cookie in LAZY_PUNDIT_ESPN_S2"
    finish
  }
  if {$scenario in {espn-private espn-retype}} {
    need "is private"
    need "Next?"
    send "\r"
    need "◆  espn_s2 cookie"
    if {$scenario eq "espn-private"} {
      send "$COOKIE\r"
      need "pasted, 300 characters"
    } else {
      send "AEB%2Fwrong\r"
      need "ESPN rejected that cookie"
      need "Next?"
      send "$DOWN"; after 200; send "\r"
      need "◆  ESPN league ID"
      send $CTRL_C
      finish
    }
  }
} else {
  send "\r"
  need "username"
  send "\r"
  need "number in the"
  if {$scenario eq "bad-id"} {
    send "123\r"
    need "no league"
    need "username"
    send $CTRL_C
    finish
  }
  send "900000000000000001\r"
}

if {$scenario eq "next-to"} { need "next to your last one" }
need "Workspace folder"
if {$scenario eq "cancel-folder"} { send $CTRL_C; finish }
if {$scenario eq "folder"} {
  send "$folder\r"
} elseif {$scenario eq "relative"} {
  send "my-league\r"
  need "full path"
  need "Workspace folder"
  send "\r"
} elseif {$scenario in {dot dot-keep}} {
  send "$home/ws.\r"
  need "ends in a dot"
  if {$scenario eq "dot-keep"} { send $DOWN; after 200 }
  send "\r"
} elseif {$scenario in {setup-lore setup-stakes espn}} {
  send "$home/ws\r"
} else {
  send "\r"
}

set UP "\033\[A"
need "Manager handles"
if {$scenario eq "skip-rest"} {
  send $UP; after 200; send "\r"
  need "Set up another"
  send "\r"
  finish
}
if {$scenario eq "rename"} {
  send $DOWN; after 200; send "\r"
  need "Handle for"
  # Clear the proposed handle, then type the new one.
  send [string repeat "\x7f" 20]; after 200; send "gus\r"
  need "Manager handles"
}
send "\r"

need "What kind of league"
if {$scenario eq "family"} { send $DOWN; after 200 }
send "\r"
need "nicknames each team"
send "\r"

need "bragging rights"
# Money at stake: buy-in 50, the default payouts, a weekly high score paying `outcome`.
proc money {outcome} {
  global DOWN
  send $DOWN; after 200; send "\r"
  need "Buy-in"
  send "50\r"
  need "Payouts by place"
  send "\r"
  need "house rules"
  send " "; after 200; send "\r"
  need "its outcome"
  send "$outcome\r"
}
if {$scenario in {stakes setup-stakes}} {
  money "\$10"
} else {
  send "\r"
}
need "family league"
send "\r"

need "starting order"
if {$scenario eq "rename"} { send $DOWN; after 200 }
send "\r"

need "Add an Anthropic key"
if {$scenario eq "key"} {
  send "\r"
  # The password prompt's own line: "Anthropic key" alone also matches the
  # explanation and the select's redraw, which come before the prompt listens.
  need "\u25c6  Anthropic key"
  send "$KEY\r"
  need "pasted, 108 characters"
  need "couldn't check it"
  need "Spend cap"
  send [string repeat "\x7f" 5]; after 200; send "0.10\r"
} else {
  send $DOWN; after 200; send "\r"
}

need "Which persona"
send "\r"

need "Set up another"
if {$scenario eq "another"} {
  # "y" alone answers a confirm: an Enter after it lands in the next prompt.
  send "y"
  need "pundit name"
  send $CTRL_C
  finish
}
if {$scenario eq "again"} {
  send "y"
  need "pundit name"
  send "\r"
  need "Which platform"
  send "\r"
  need "username"
  send "\r"
  need "number in the"
  send "900000000000000001\r"
  need "already set up in"
  need "username"
  send $CTRL_C
  finish
}
send "\r"
if {$scenario ni {setup-lore setup-stakes espn}} { finish }

expect eof
wait
if {$scenario eq "espn"} {
  cd "$home/ws"
  # A cookie in the environment wins over the stored one, which setup espn says.
  set env(LAZY_PUNDIT_ESPN_S2) "AEB%2Fenv"
  spawn node "$repo/src/cli.ts" setup espn
  need "LAZY_PUNDIT_ESPN_S2 is set"
  need "Save a new espn_s2"
  send "\r"
  need "◆  espn_s2 cookie"
  send "$COOKIE\r"
  need "pasted, 300 characters"
  need "espn set"
  finish
}
if {$scenario eq "setup-stakes"} {
  cd "$home/ws"
  exec node "$repo/src/cli.ts" draft 2>@1
  exec node "$repo/src/cli.ts" publish --yes 2>@1
  spawn node "$repo/src/cli.ts" setup stakes
  need "bragging rights"
  money "\$20"
  need "family league"
  send "\r"
  need "pays \$20, not the \$10 it paid at week 8"
  need "Overwrite"
  send "y"
  need "stakes set"
  finish
}
set lore [open "$home/ws/lore.md" a]
puts $lore "\n## Running jokes\n\n- The trade that never was."
close $lore
cd "$home/ws"
foreach answer {n y} {
  spawn node "$repo/src/cli.ts" setup lore
  need "What kind of league"
  send "\r"
  need "nicknames each team"
  send "\r"
  need "Overwrite"
  send "$answer"; after 200; send "\r"
  if {$answer eq "n"} {
    need "left as it was"
    expect eof
    wait
  } else {
    need "lore set"
  }
}
finish

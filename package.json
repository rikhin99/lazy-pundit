{
  "name": "lazy-pundit",
  "version": "0.0.0",
  "description": "Local, CLI-first power rankings with checked stats for fantasy football leagues.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "lazy-pundit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build && husky",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "scrub:sleeper": "node scripts/scrub-sleeper.ts",
    "fixtures:raw": "git archive fixtures/raw fixtures/raw | tar -x"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
